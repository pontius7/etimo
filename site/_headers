/data/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# content-hashed files (name changes whenever the content does): cache for a year
/h/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# map tiles: the address carries the build's version (?v=), so a new build never meets an old cached tile
/map-next/tiles/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/x-protobuf
  Access-Control-Allow-Origin: *

# MapLibre: its address carries its version (?v= in site/map-gl.js, and on its worker), so it is cached for a year
/map-next/vendor/*
  Cache-Control: public, max-age=31536000, immutable
